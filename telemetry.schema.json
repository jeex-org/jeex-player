          "anyOf": [
            {
              "type": "string",
              "maxLength": 200,
              "pattern": "^\\/[^?#\\s]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "type": "object",
          "properties": {
            "project": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bake": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scene": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "project",
            "bake",
            "scene"
          ],
          "additionalProperties": false
        },
        "lang": {
          "type": "string",
          "enum": [
            "en",
            "de",
            "fr",
            "it",
            "es",
            "sr-Latn",
            "ru",
            "other"
          ]
        },
        "group": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "network",
            "scene_format",
            "manifest_format",
            "model_format",
            "webgl_unavailable",
            "context_lost",
            "size_limit",
            "exception",
            "rejection",
            "other"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "scene_load",
            "model_load",
            "capture",
            "mode",
            "tour",
            "embed",
            "bridge",
            "runtime"
          ]
        },
        "name": {
          "type": "string",
          "enum": [
            "Error",
            "TypeError",
            "RangeError",
            "ReferenceError",
            "SyntaxError",
            "EvalError",
            "URIError",
            "AggregateError",
            "InternalError",
            "ViewerLibError",
            "SceneValidationError",
            "AbortError",
            "NetworkError",
            "NotSupportedError",
            "NotAllowedError",
            "InvalidStateError",
            "SecurityError",
            "QuotaExceededError",
            "DataCloneError",
            "EncodingError",
            "TimeoutError",
            "OperationError",
            "UnknownError"
          ]
        },
        "frames": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 120,
                "pattern": "^(?:lazy-)?jeex-viewer[\\w.-]*\\.js$"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              }
            },
            "required": [
              "file",
              "line",
              "column"
            ],
            "additionalProperties": false
          }
        },
        "browser": {
          "type": "string",
          "pattern": "^(?:chromium-\\d{1,3}x|firefox-\\d{1,3}x|safari-\\d{1,3}|other)$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "schema",
        "player",
        "embed",
        "site",
        "page",
        "subject",
        "lang",
        "group",
        "code",
        "stage",
        "name",
        "frames",
        "browser",
        "count"
      ],
      "additionalProperties": false
    }
  ]
}
