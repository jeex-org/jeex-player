{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/embed/index.ts",
    "src/embed/element-entry.ts",
    "src/embed/frame-entry.ts",
    "src/embed/iife-entry.ts",
    "src/embed/host.ts",
    "src/app/viewer-api.ts",
    "src/main.ts",
    "src/main-embed.ts",
    "src/**/*.test.ts",
    "scripts/*.ts",
    "scripts/browser-check/*.ts",
    "dev/**/*.ts",
    "tests/component/*.test.ts",
    "tests/e2e/*.spec.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "dev/**/*.ts",
    "vite*.config.ts",
    "tests/**/*.ts"
  ],
  "vite": false,
  "ignoreDependencies": [
    "@swc/core"
  ],
  "ignoreBinaries": [
    "ffmpeg"
  ],
  "ignoreExportsUsedInFile": true
}
